{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-onboarding-ingestion/schemas/ingestion-job.schema.json",
  "title": "IngestionJob",
  "description": "One ingestion job; one file becomes one Airflow DAG named ingest__<name>. `source.read` and `sink.params` are validated separately against the schemas derived from the templates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "owner", "connection", "source", "sink"],
  "properties": {
    "kind": { "const": "IngestionJob" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$",
      "description": "Immutable; equals the file name and gives the DAG id ingest__<name>"
    },
    "owner": { "type": "string", "minLength": 1 },
    "connection": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "read": { "type": "object" }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "params"],
      "properties": {
        "template": { "type": "string", "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$" },
        "params": { "type": "object" }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_count": { "enum": ["exact", "tolerance", "skip"], "default": "exact" },
        "tolerance_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
      },
      "if": { "properties": { "row_count": { "const": "tolerance" } }, "required": ["row_count"] },
      "then": { "required": ["tolerance_pct"] }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": { "type": "integer", "minimum": 1, "maximum": 64 },
        "timeout": { "$ref": "#/definitions/duration", "default": "2h" },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5, "default": 1 }
      }
    },
    "schedule": {
      "type": "string",
      "minLength": 1,
      "description": "Cron expression or Airflow preset; omitted means manual runs only"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
      "uniqueItems": true
    }
  },
  "definitions": {
    "duration": { "type": "string", "pattern": "^[1-9][0-9]*(s|m|h)$" }
  }
}
