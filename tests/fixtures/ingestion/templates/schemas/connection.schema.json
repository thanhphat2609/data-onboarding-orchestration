{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://data-onboarding-ingestion/schemas/connection.schema.json",
  "title": "Connection",
  "description": "One onboarded source instance. `params` is validated separately against the schema derived from the source template's connection_params.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "name", "template", "owner", "params"],
  "properties": {
    "kind": { "const": "Connection" },
    "name": { "$ref": "#/definitions/name" },
    "template": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "description": "<source-template>@<version>"
    },
    "owner": { "type": "string", "minLength": 1 },
    "params": { "type": "object" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_concurrent_runs": { "type": "integer", "minimum": 1, "maximum": 16, "default": 2 },
        "max_partition_num": { "type": "integer", "minimum": 1, "maximum": 32 },
        "run_window": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Allowed local time window, for example 19:00-06:00"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "groups": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  },
  "definitions": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,62}$",
      "description": "Lowercase kebab-case; equals the file name"
    }
  }
}
