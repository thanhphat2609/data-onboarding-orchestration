{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TransformationJob",
  "description": "One dbt run as an Airflow DAG transform__<name> (ADR-0004). File name = name.",
  "type": "object",
  "required": ["kind", "name", "owner", "select"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "TransformationJob" },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 80 },
    "owner": { "type": "string", "minLength": 1 },
    "after": {
      "description": "Run when every listed ingestion job or transformation has published its Asset.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "additionalProperties": false,
        "properties": {
          "ingestion": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "transformation": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "schedule": { "description": "Cron instead of `after`; not both.", "type": ["string", "null"] },
    "select": { "description": "dbt node selection, for example tag:sales", "type": "string", "minLength": 1 },
    "exclude": { "type": "string", "minLength": 1 },
    "full_refresh": { "type": "boolean" },
    "vars": { "type": "object" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": { "type": "string", "pattern": "^[0-9]+[smh]$" },
        "threads": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
