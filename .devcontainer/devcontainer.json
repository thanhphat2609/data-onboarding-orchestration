{
  // Non-prod Airflow on GitHub Codespaces. data-onboarding-ingestion is cloned next to this repository and started
  // first: Airflow reads its files and needs its Flink and Redpanda.
  "name": "data-onboarding-orchestration (non-prod)",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-noble",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "customizations": {
    "codespaces": {
      "repositories": {
        "thanhphat2609/data-onboarding-ingestion": { "permissions": { "contents": "write" } }
      }
    }
  },
  "forwardPorts": [3000, 8080, 8081],
  "portsAttributes": {
    "3000": { "label": "Web UI", "onAutoForward": "notify" },
    "8080": { "label": "Airflow", "onAutoForward": "silent" },
    "8081": { "label": "Flink web UI", "onAutoForward": "silent" },
    "8000": { "label": "Ingestion API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash infrastructure/non-prod/codespace-setup.sh",
  "postStartCommand": "docker compose -f ../data-onboarding-ingestion/infrastructure/non-prod/docker-compose.yml up -d --build && docker compose -f infrastructure/non-prod/docker-compose.yml up -d --build"
}
