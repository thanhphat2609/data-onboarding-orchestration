# Prod VM 1: every setting of infrastructure/prod/vm1/.env.
# The Deploy workflow writes this file on the VM from the repository secret or variable of the same name
# (infrastructure/prod/render_env.py): set values in GitHub, never on the VM (replaced on every deploy).
# Values below are examples only. __GENERATE__ = required secret; the rest are variables.

# --- Secrets ---
# Shared PostgreSQL server of the data-onboarding-agent stack (ingestion ADR-0011): same value as its
# POSTGRES_AIRFLOW_PASSWORD. METADATA_DB_HOST only if the server isn't reachable as `postgres` on data-platform.
AIRFLOW_DB_PASSWORD=__GENERATE__
METADATA_DB_HOST=

AIRFLOW_FERNET_KEY=__GENERATE__
AIRFLOW_JWT_SECRET=__GENERATE__
# Login `admin` in the Airflow UI.
AIRFLOW_ADMIN_PASSWORD=__GENERATE__

# --- Variables ---
# Checkout of data-onboarding-ingestion, relative to infrastructure/prod/vm1/ or absolute. Empty = next to this one.
INGESTION_REPO_DIR=
# Checkout of data-onboarding-transformation (the dbt project), same rules. Empty = next to this one.
TRANSFORMATION_REPO_DIR=
